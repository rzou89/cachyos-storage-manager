# ============================================================
# CachyOS Storage Manager - Configuration Example
#
# Copy this file to:
#   ~/.config/cachyos-storage-manager/config.fish
#
# Or simply run:
#   csm setup
#
# which generates this file interactively.
#
# Every variable below has a sane default computed from CSM_ROOT, so
# you only strictly need CSM_TARGET. Unused sections can be deleted.
# ============================================================

# ------------------------------------------------------------
# Global
# ------------------------------------------------------------

# Drive where all CSM-managed data will live.
# Must be an absolute path, on a separate filesystem from /.
# Do NOT use spaces: pacman's CacheDir directive rejects them.
set -g CSM_TARGET "/mnt/DataCachyOS"

# Base folder for everything CSM manages on the target drive.
# Defaults to $CSM_TARGET/CachyOS-Storage-Data-Migration.
set -g CSM_ROOT "$CSM_TARGET/CachyOS-Storage-Data-Migration"

# Create a backup before migrating? (1 = yes, 0 = no)
set -g CSM_BACKUP_BEFORE_MIGRATE 1

# ------------------------------------------------------------
# Flatpak
# ------------------------------------------------------------

# Flatpak application data (user data: config, cache, savegames).
# Symlinked from ~/.var/app/<app-id>.
set -g CSM_FLATPAK_DIR "$CSM_ROOT/flatpak/flatpak-data"

# Flatpak system core (applications, runtimes, OSTree repository, exports).
# Registered in /etc/flatpak/installations.d/.
set -g CSM_FLATPAK_CORE_DIR "$CSM_ROOT/flatpak/flatpak-core/system"

# Name of the Flatpak installation entry created by CSM.
set -g CSM_FLATPAK_INSTALLATION "datacachyos"

# Enable the Flatpak data watcher service? (1 = yes, 0 = no)
set -g CSM_FLATPAK_WATCH 1

# ------------------------------------------------------------
# AUR & package caches
# ------------------------------------------------------------

# Where paru clones AUR repositories.
# Symlinked from ~/.cache/paru/clone.
set -g CSM_PARU_DIR "$CSM_ROOT/cache/paru"

# Pacman package cache on the target drive.
# Registered as an extra CacheDir in /etc/pacman.conf.
set -g CSM_PACMAN_DIR "$CSM_ROOT/cache/pacman"

# ------------------------------------------------------------
# User cache
# ------------------------------------------------------------

# Base folder for migrated ~/.cache entries.
set -g CSM_CACHE_DIR "$CSM_ROOT/cache"

# Folders under ~/.cache that MAY be migrated.
# Anything not listed here is left alone.
# 'paru'/'yay' are intentionally absent: modul paru menangani
# ~/.cache/paru/clone sendiri lewat symlink terpisah.
set -g CSM_CACHE_WHITELIST mozilla google-chrome chromium zen pip yarn npm \
    go-build cargo thumbnails electron node-gyp clangd

# Folders under ~/.cache that must NEVER be migrated.
# This wins over CSM_CACHE_WHITELIST.
set -g CSM_CACHE_BLACKLIST fontconfig mesa_shader_cache mesa_shader_cache_db \
    nvidia pipewire wireplumber systemd dconf ibus fcitx5 ksycoca5 \
    plasmashell gnome-shell

# ------------------------------------------------------------
# Steam & gaming
# ------------------------------------------------------------

# Proton/Wine prefixes (Steam compatdata).
set -g CSM_WINEPREFIX_DIR "$CSM_ROOT/apps/wine-prefixes"

# Shader caches (Steam shadercache, DXVK, Mesa).
set -g CSM_SHADERCACHE_DIR "$CSM_ROOT/shader-cache"
